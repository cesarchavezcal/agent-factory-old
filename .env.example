# ============================================================================
# Agent Factory Template Environment Configuration (100% Zero-API-Key)
# ============================================================================
# IMPORTANT: Do NOT set GEMINI_API_KEY, XAI_API_KEY, CURSOR_API_KEY,
# ANTHROPIC_API_KEY, or OPENAI_API_KEY. All models run via personal accounts
# in T3 Code (Antigravity + Cursor + Grok).

# Required GitHub account identity for PR delivery (Step 6)
GITHUB_ACCOUNT=cesarchavezcal

# Optional: Neon Free Tier Postgres connection string for outer-loop
# Webhook Inbox & Vercel Live Board sync. Leave empty for 100% local mode.
NEON_DATABASE_URL=

# Optional: Webhook signing secrets for Vercel /api/webhooks endpoint
LINEAR_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=

# Local Mission Control UI Port
ORCH_UI_PORT=4321
